#!/bin/bash
# klod [project-dir]
# klod --init
#
# Starts a bash shell in which every path listed in <project-dir>/.agentsdeny
# is unreadable and unwritable. The denial is an AppArmor profile loaded for
# this sandbox (klod_<project>_<pid>): it matches by path, so it also covers
# entries that do not exist yet and files replaced from outside while the
# sandbox runs. bwrap runs under that profile and adds the per-sandbox Claude
# Code daemon directory and the KLOD_PROJECT_DIR marker.
#
# Needs AppArmor active in the kernel. Loading the profile runs one sudo
# command, which asks for the password; the same command unloads the
# profiles of klod sandboxes that have exited. klod stops without starting a
# shell when AppArmor is not active or the profile does not load.
set -e

#
# klod --print-profile [project-dir] prints the profile it would load, and
# exits without sudo and without AppArmor being active.

MODE=shell
if [[ "$1" == "--print-profile" ]]; then
  MODE=print
  shift
fi

PROJECT_DIR=$(realpath "${1:-$PWD}")
SECRETS_FILES="$PROJECT_DIR/.agentsdeny"

if [[ "$1" == "--init" ]]; then
  touch "$SECRETS_FILES"
  echo "Created $SECRETS_FILES"
  exit 0
fi

die() { echo "klod: $*" >&2; exit 1; }

if [[ $MODE == shell && "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null)" != Y ]]; then
  die "AppArmor is not active in the kernel (/sys/module/apparmor/parameters/enabled is not Y); no shell started"
fi

BWRAP_ARGS=(--dev-bind / /)
DENY_PATHS=()

# expand_entry <entry>
# Writes <entry> to EXPANDED with a leading "~" or "~/" replaced by $HOME and
# each $NAME or ${NAME} replaced by the environment variable NAME. A "$" not
# followed by a name stays literal. The function does not call eval, so "$(...)"
# and backticks stay literal text. Returns 1 and writes the name to UNSET_NAME
# when a referenced variable is unset.
expand_entry() {
  local rest="$1" re='^\{([A-Za-z_][A-Za-z0-9_]*)\}(.*)$|^([A-Za-z_][A-Za-z0-9_]*)(.*)$'
  local name
  EXPANDED=""
  if [[ "$rest" == "~" || "$rest" == "~/"* ]]; then
    rest="$HOME${rest:1}"
  fi
  while [[ "$rest" == *'$'* ]]; do
    EXPANDED+="${rest%%\$*}"
    rest="${rest#*\$}"
    if [[ "$rest" =~ $re ]]; then
      name="${BASH_REMATCH[1]}${BASH_REMATCH[3]}"
      rest="${BASH_REMATCH[2]}${BASH_REMATCH[4]}"
      if ! printenv "$name" >/dev/null; then
        UNSET_NAME="$name"
        return 1
      fi
      EXPANDED+="$(printenv "$name")"
    else
      EXPANDED+='$'
    fi
  done
  EXPANDED+="$rest"
}

if [[ -f "$SECRETS_FILES" ]]; then
  while IFS= read -r entry; do
    entry="${entry%"${entry##*[![:space:]]}"}"
    [[ -z "$entry" || "$entry" =~ ^# ]] && continue

    # An unset variable would expand to "" and turn "$FOO/secret" into
    # "/secret", so the entry is skipped.
    if ! expand_entry "$entry"; then
      echo "Warning: .agentsdeny entry uses unset variable $UNSET_NAME, not denied: $entry" >&2
      continue
    fi
    entry="$EXPANDED"

    if [[ "$entry" = /* ]]; then
      target="$entry"
    else
      target="$PROJECT_DIR/$entry"
    fi

    # AppArmor matches the path after symlinks are resolved, so the rule
    # names the resolved path (/var/run/docker.sock is /run/docker.sock).
    # realpath -m also resolves "..", and accepts paths that do not exist yet.
    resolved="$(realpath -m -- "$target")"
    [[ " ${DENY_PATHS[*]} " == *" $resolved "* ]] || DENY_PATHS+=("$resolved")
  done < "$SECRETS_FILES"
fi

# aa_quote <path> [glob suffix]: <path> as a quoted AppArmor path, with the
# characters that AppArmor reads as glob or variable syntax escaped, so the
# rule matches that path and nothing else; the suffix (such as "/**") is
# appended unescaped.
aa_quote() {
  local p="$1" suffix="${2-}" out="" c i
  for (( i = 0; i < ${#p}; i++ )); do
    c="${p:i:1}"
    case "$c" in
      '\'|'"'|'*'|'?'|'['|']'|'{'|'}'|'^'|'$'|'@') out+="\\$c" ;;
      *) out+="$c" ;;
    esac
  done
  printf '"%s%s"' "$out" "$suffix"
}

# The profile allows everything except the listed paths. Each entry is denied
# as a path and as a directory tree, so a file entry stays denied if a
# directory takes its place and the other way round.
PROJECT_NAME="${PROJECT_DIR##*/}"
PROFILE_NAME="klod_${PROJECT_NAME//[^A-Za-z0-9_-]/_}_$$"

write_profile() {
  echo 'abi <abi/4.0>,'
  echo
  echo "profile $PROFILE_NAME flags=(attach_disconnected,mediate_deleted) {"
  for rule in file capability network mount remount umount pivot_root signal \
              ptrace dbus unix userns change_profile mqueue io_uring; do
    echo "  $rule,"
  done
  echo
  for p in "${DENY_PATHS[@]}"; do
    echo "  deny $(aa_quote "${p%/}" '{,/,/**}') rwlkmx,"
  done
  echo "}"
}

if [[ $MODE == print ]]; then
  write_profile
  exit 0
fi

RUNTIME_DIR="${KLOD_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/klod}"
mkdir -p -m 700 "$RUNTIME_DIR"
PROFILE_FILE="$RUNTIME_DIR/$PROFILE_NAME.profile"
write_profile > "$PROFILE_FILE"

# One sudo command loads this sandbox's profile and unloads the profiles of
# klod sandboxes whose process has exited (the profile name ends in the pid
# of the shell's bwrap, which keeps klod's pid through exec).
echo "klod: loading AppArmor profile $PROFILE_NAME (${#DENY_PATHS[@]} denied paths) with sudo" >&2
sudo bash -c '
  set -e
  apparmor_parser -r -- "$1"
  for name in $(sed -n "s/^\(klod_[A-Za-z0-9_-]*_\([0-9]*\)\) (.*/\1 \2/p" /sys/kernel/security/apparmor/profiles | awk "{print \$1\":\"\$2}"); do
    pid=${name##*:}; name=${name%:*}
    [ "$name" = "$2" ] && continue
    kill -0 "$pid" 2>/dev/null || printf "%s" "$name" > /sys/kernel/security/apparmor/.remove
  done
' klod-load "$PROFILE_FILE" "$PROFILE_NAME" || die "loading the AppArmor profile $PROFILE_NAME failed; no shell started"

# Claude Code's background service (claude daemon) listens in
# /tmp/cc-daemon-<uid>. Each sandbox mounts its own empty directory there, so a
# Claude inside reaches only a service started inside the same sandbox, which
# runs with the same masks. A service started outside stays out of reach.
DAEMON_DIR="/tmp/cc-daemon-$(id -u)"
mkdir -p -m 700 "$DAEMON_DIR"
BWRAP_ARGS+=(--perms 0700 --tmpfs "$DAEMON_DIR")

# Tells processes inside which project's deny list applies and which profile
# enforces it. The Claude Code SessionStart check reads both.
BWRAP_ARGS+=(--setenv KLOD_PROJECT_DIR "$PROJECT_DIR")
BWRAP_ARGS+=(--setenv KLOD_APPARMOR_PROFILE "$PROFILE_NAME")

cd "$PROJECT_DIR"
exec aa-exec -p "$PROFILE_NAME" -- bwrap "${BWRAP_ARGS[@]}" -- bash